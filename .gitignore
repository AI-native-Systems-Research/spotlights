# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/

# Local secrets / pipeline-only claude config (proxy creds + model pin)
.env
.claude-pipeline/

# Tooling caches
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# uv
uv.lock

# Editors / OS
.idea/
.vscode/
.DS_Store
*.swp

# Local run artifacts
tmp/

.omx/

# Per-run output (signal pipeline + repo bench).
# Each invocation writes a fresh dir; nothing here is meant to be tracked.
/runs/

# Repo bench — large or rebuildable artifacts.
# prs.jsonl is 16+ MB and can be re-fetched via `repo-bench aggregate`.
# Per-PR diffs (~17 MB total at 200 PRs) re-fetched via `fetch-diffs`.
# *.partial / pr_numbers.json are scrape-resume artifacts, removed on finalize.
data/repo_bench/raw/**/prs.jsonl
data/repo_bench/raw/**/*.partial
data/repo_bench/raw/**/pr_numbers.json
data/repo_bench/raw/**/diffs/

# Internal-only experiment outputs (kept on disk, not pushed).
docs/repo-bench/baseline_recon_drill_score_a.md
docs/repo-bench/PROGRESS_UI_BRIEF.md
scripts/discovery_benchmark_experiments/

# vLLM checkout (read-only reference, not part of this repo)
vllm/

# Observability bench bundles (Yaroker's module owns these; tracked separately)
data/[0-9]*Z_*/

# Signal-pipeline run output that landed under data/ (smoke runs, ad-hoc work).
# Discovery-benchmark output stays under data/repo_bench/ and is not
# affected.
data/otel-smoke-*/
data/signal-pipeline-*/
