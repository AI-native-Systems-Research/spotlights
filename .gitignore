# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/

# Local secrets / pipeline-only claude config (proxy creds + model pin)
.env
.claude-pipeline/

# Generated by `spotlights-engine init` — canonical skill source lives in
# templates/commands/. Contributors run init locally to dogfood the slash
# commands the same way external users do.
.claude/
# ...except the DAM image's workspace seed, which must ship with the repo so
# the docker build context includes Claude Code's LiteLLM routing config.
!DAM/spotlights-agent/workspace/.claude/
.spotlights/

# Tooling caches
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# uv

# Editors / OS
.idea/
.vscode/
.DS_Store
*.swp

# Local run artifacts
tmp/
output/

.omx/

# Secrets / env
.env

# Logs and runtime output
logs/
artifacts/**/logs/
*.stdout
*.stderr

# Local scratch
commands.txt

