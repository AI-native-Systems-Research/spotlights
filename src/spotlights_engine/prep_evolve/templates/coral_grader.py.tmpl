"""CORAL grader for ${repo_name} - ${module_qn} - ${candidate_id}.

Generated by spotlights-engine prep-evolve. CORAL spawns coding agents that
edit a git worktree of the target repo; this grader scores each attempt and the
direction (${direction}) is set in task.yaml's grader.direction.

!!  YOU MUST COMPLETE THE PERFORMANCE MEASUREMENT before results are meaningful.
    Spotlights believes the oracle is:
      correctness: ${correctness_oracle}
      performance: ${performance_oracle}
    The correctness gate and out-of-scope guard below are wired from that
    belief; the performance score is a TODO that currently returns a degenerate
    value so the pipeline is launchable end to end.
"""

from __future__ import annotations

import subprocess

from coral.grader import TaskGrader


class Grader(TaskGrader):
    """Scores an evolved worktree for the selected candidate."""

    def evaluate(self):
        args = self.args or {}
        target_files = args.get("target_files", ${target_files_repr})
        correctness_commands = args.get("correctness_oracle", ${correctness_commands_repr})

        # --- Out-of-scope guard: reject edits outside the in-scope files. ---
        changed = self._changed_files()
        out_of_scope = [
            f for f in changed if f not in set(target_files)
        ]
        if out_of_scope:
            return self.fail(
                "out-of-scope edits (stay within the in-scope files): "
                + ", ".join(sorted(out_of_scope))
            )

        # --- Correctness gate ---
        for cmd in correctness_commands:
            proc = subprocess.run(
                cmd if isinstance(cmd, list) else ["bash", "-lc", cmd],
                cwd=self.codebase_path,
                capture_output=True,
                text=True,
                timeout=self.timeout or None,
            )
            if proc.returncode != 0:
                label = cmd if isinstance(cmd, str) else " ".join(cmd)
                return self.fail(
                    "correctness gate failed: "
                    + label
                    + "\n"
                    + proc.stderr.strip()[-2000:]
                )

        # --- Performance measurement (TODO) ---
        # TODO: build/benchmark inside self.codebase_path and return a score in
        # the configured direction (${direction}). Until then, return a
        # degenerate score so the loop is launchable.
        return self.score(
            0.0,
            "performance measurement not yet implemented (TODO); correctness "
            "gate passed and edits stayed in scope",
        )

    def _changed_files(self) -> list[str]:
        """Files the agent changed, relative to the fork point.

        CORAL grades each attempt in a *detached* worktree checked out at the
        agent's commit (`git worktree add --detach <commit>`), so the agent's
        edits are already in HEAD — `git diff HEAD` and `git status` are both
        empty here. To see what the agent actually changed we diff HEAD against
        the base commit it branched from (the post-seed default-branch tip),
        located via merge-base. Falls back to the root commit if no default
        branch ref resolves.
        """
        base = self._base_commit()
        names: list[str] = []
        if base:
            proc = subprocess.run(
                ["git", "diff", "--name-only", base, "HEAD"],
                cwd=self.codebase_path,
                capture_output=True,
                text=True,
            )
            names = [ln.strip() for ln in proc.stdout.splitlines() if ln.strip()]
        # Include any uncommitted working-tree changes too (best effort).
        proc2 = subprocess.run(
            ["git", "status", "--porcelain"],
            cwd=self.codebase_path,
            capture_output=True,
            text=True,
        )
        for ln in proc2.stdout.splitlines():
            name = ln[3:].strip()
            if name and name not in names:
                names.append(name)
        return names

    def _base_commit(self) -> str:
        """Resolve the commit the agent branched from (fork point).

        Tries merge-base of HEAD against each likely default-branch ref; falls
        back to the repository's root commit. Returns "" if nothing resolves.
        """
        for ref in ("origin/HEAD", "main", "master", "origin/main", "origin/master"):
            mb = subprocess.run(
                ["git", "merge-base", "HEAD", ref],
                cwd=self.codebase_path,
                capture_output=True,
                text=True,
            )
            base = mb.stdout.strip()
            if mb.returncode == 0 and base:
                return base
        root = subprocess.run(
            ["git", "rev-list", "--max-parents=0", "HEAD"],
            cwd=self.codebase_path,
            capture_output=True,
            text=True,
        )
        lines = [ln.strip() for ln in root.stdout.splitlines() if ln.strip()]
        return lines[-1] if lines else ""
