"""skydiscover evaluator for ${repo_name} - ${module_qn} - ${candidate_id}.

Generated by spotlights-engine prep-evolve. skydiscover calls
`evaluate(program_path)` on each evolved single file and MAXIMIZES the returned
`combined_score`.

!!  YOU MUST COMPLETE THE PERFORMANCE MEASUREMENT before results are meaningful.
    Spotlights believes the oracle is:
      correctness: ${correctness_oracle}
      performance: ${performance_oracle}
      direction:   ${direction}
    The correctness gate below is wired from that belief; the performance
    measurement is a TODO that currently returns a degenerate score so the
    pipeline is launchable end to end.
"""

from __future__ import annotations

import os
import shutil
import subprocess
import tempfile

# The single file skydiscover evolves maps back into the repo at this path.
TARGET_FILE = ${target_file_repr}
REPO_PATH = ${repo_path_repr}
# Shell command(s) used as the correctness gate (parsed from the candidate
# rationale). Empty list => no correctness gate (you should add one).
CORRECTNESS_COMMANDS = ${correctness_commands_repr}

MARKER_START = "# EVOLVE-BLOCK-START"
MARKER_END = "# EVOLVE-BLOCK-END"

# Byte-for-byte prefix/suffix outside the evolve block, captured from the seed
# at generation time. The evolved program must keep these regions unchanged.
SEED_PREFIX = ${seed_prefix_repr}
SEED_SUFFIX = ${seed_suffix_repr}


def _bad(reason, **artifacts):
    art = {"status": "rejected", "reason": reason}
    art.update(artifacts)
    return {"combined_score": -1.0e9, "artifacts": art}


def _split_markers(text):
    """Return (prefix, body, suffix) around the single marker block, or None.

    Markers occupy their own lines in the generated seed. Split line-wise so
    stripping the marker lines reconstructs the original source exactly.
    """
    lines = text.splitlines(keepends=True)
    start_indexes = [
        i for i, line in enumerate(lines) if line.strip() == MARKER_START
    ]
    end_indexes = [
        i for i, line in enumerate(lines) if line.strip() == MARKER_END
    ]
    if len(start_indexes) != 1 or len(end_indexes) != 1:
        return None
    start = start_indexes[0]
    end = end_indexes[0]
    if end <= start:
        return None
    return (
        "".join(lines[:start]),
        "".join(lines[start + 1:end]),
        "".join(lines[end + 1:]),
    )


def evaluate(program_path):
    """Score the evolved program. skydiscover maximizes combined_score."""
    with open(program_path, "r", encoding="utf-8") as fh:
        evolved = fh.read()

    parts = _split_markers(evolved)
    if parts is None:
        return _bad(
            "evolved program lost the EVOLVE-BLOCK markers; refusing to map "
            "an unbounded edit back into the repo"
        )
    prefix, body, suffix = parts

    # The model may only touch the marked block. Anything outside it must match
    # the seed byte-for-byte.
    if prefix != SEED_PREFIX or suffix != SEED_SUFFIX:
        return _bad("out-of-scope edit: code outside the EVOLVE-BLOCK changed")

    # Reconstruct the file as it should land in the repo (markers stripped).
    normalized = prefix + body + suffix

    workdir, cleanup = _make_repo_overlay()
    try:
        dest = os.path.join(workdir, TARGET_FILE)
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        with open(dest, "w", encoding="utf-8") as fh:
            fh.write(normalized)

        # --- Correctness gate ---
        for cmd in CORRECTNESS_COMMANDS:
            proc = subprocess.run(
                cmd if isinstance(cmd, list) else ["bash", "-lc", cmd],
                cwd=workdir,
                capture_output=True,
                text=True,
            )
            if proc.returncode != 0:
                label = cmd if isinstance(cmd, str) else " ".join(cmd)
                return _bad(
                    "correctness gate failed: " + label,
                    stdout=proc.stdout[-2000:],
                    stderr=proc.stderr[-2000:],
                )

        # --- Performance measurement (TODO) ---
        # TODO: build/benchmark inside `workdir` and compute a score that, when
        # MAXIMIZED, drives the objective in the right direction.
        # direction = ${direction}
        #   - minimize: return an IMPROVEMENT or NEGATIVE-latency value
        #     (e.g. baseline_latency - measured_latency), never raw latency.
        #   - maximize: return the measured throughput-style metric directly.
        score = 0.0  # degenerate placeholder until perf measurement lands.

        return {
            "combined_score": score,
            "artifacts": {
                "status": "ok",
                "note": "performance measurement not yet implemented (TODO)",
            },
        }
    finally:
        cleanup()


def _make_repo_overlay():
    """Create a disposable copy of the repo to overlay the evolved file onto.

    Prefers a git worktree when REPO_PATH is a git checkout; falls back to a
    temp copytree otherwise. Returns (path, cleanup_callable).
    """
    if _is_git_checkout(REPO_PATH):
        tmp = tempfile.mkdtemp(prefix="skydiscover-wt-")
        wt = os.path.join(tmp, "wt")
        proc = subprocess.run(
            ["git", "worktree", "add", "--detach", wt, "HEAD"],
            cwd=REPO_PATH,
            capture_output=True,
            text=True,
        )
        if proc.returncode == 0:
            def cleanup():
                subprocess.run(
                    ["git", "worktree", "remove", "--force", wt],
                    cwd=REPO_PATH,
                    capture_output=True,
                    text=True,
                )
                shutil.rmtree(tmp, ignore_errors=True)

            return wt, cleanup
        shutil.rmtree(tmp, ignore_errors=True)

    # Fallback: full copy (slower; use sparingly on large repos).
    tmp = tempfile.mkdtemp(prefix="skydiscover-copy-")
    dst = os.path.join(tmp, "repo")
    shutil.copytree(REPO_PATH, dst, symlinks=True, ignore=shutil.ignore_patterns(".git"))

    def cleanup():
        shutil.rmtree(tmp, ignore_errors=True)

    return dst, cleanup


def _is_git_checkout(path):
    proc = subprocess.run(
        ["git", "rev-parse", "--is-inside-work-tree"],
        cwd=path,
        capture_output=True,
        text=True,
    )
    return proc.returncode == 0 and proc.stdout.strip() == "true"


if __name__ == "__main__":
    import sys

    print(evaluate(sys.argv[1]))
