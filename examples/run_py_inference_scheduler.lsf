#!/bin/bash
#BSUB -J spotlights-py-inference-scheduler
#BSUB -q normal
#BSUB -n 8
#BSUB -R "span[hosts=1]"
#BSUB -o output/spotlights_py_inference_scheduler.%J.stdout
#BSUB -e output/spotlights_py_inference_scheduler.%J.stderr

set -euo pipefail

PROJECT_DIR=/u/ophirazu/projects/spotlights
TARGET_REPO=/u/ophirazu/projects/py-inference-scheduler
OUTPUT_DIR="$PROJECT_DIR/output/py_inference_scheduler_lsf"
ARTIFACTS_DIR="$OUTPUT_DIR/artifacts"

cd "$PROJECT_DIR"

if [ ! -r .venv/bin/activate ]; then
  echo "ERROR: missing project venv at $PROJECT_DIR/.venv" >&2
  exit 1
fi

if [ ! -d "$TARGET_REPO/.git" ]; then
  echo "ERROR: target repo not found at $TARGET_REPO" >&2
  exit 1
fi

# Activate the project venv that provides `spotlights-engine`.
source .venv/bin/activate

# The engine shells out to the `claude` and `codex` CLIs. LSF compute nodes
# may not inherit the interactive login PATH, so pin the dirs where those
# binaries live: claude -> ~/.local/bin, codex -> the nvm node bin.
# `claude` authenticates via ~/.claude/.credentials.json, so $HOME must reach
# the compute node (it does by default).
export PATH="$HOME/.local/bin:$HOME/.nvm/versions/node/v22.20.0/bin:$PATH"

# Optional: source a .env for any extra config (e.g. SPOTLIGHTS_CLAUDE_BIN).
if [ -f .env ]; then
  set -a
  source .env
  set +a
fi

# Sanity-check required CLIs before the long run.
for bin in spotlights-engine claude codex; do
  command -v "$bin" >/dev/null || { echo "ERROR: '$bin' not found on PATH" >&2; exit 1; }
done

mkdir -p "$ARTIFACTS_DIR"

spotlights-engine \
  --repo "$TARGET_REPO" \
  --repo-url https://github.com/llm-d-incubation/py-inference-scheduler \
  --objective "increase GPU utilization without significantly slowing down job execution" \
  --max-parallel 5 \
  --max-findings-per-module 15 \
  --max-parallel-candidates 10 \
  --no-review \
  --output-folder "$OUTPUT_DIR" \
  --artifacts-dir "$ARTIFACTS_DIR"
